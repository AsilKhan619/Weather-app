# Copy to .env and fill in as needed. Nothing here is required to have a value
# for `make up && make demo` to work — every default runs the full data
# platform locally at zero cost.

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nimbus
POSTGRES_USER=nimbus
POSTGRES_PASSWORD=nimbus_dev_only
# Read-only role used by the AI agent's run_sql tool (created by migrations)
POSTGRES_READONLY_USER=nimbus_ro
POSTGRES_READONLY_PASSWORD=nimbus_ro_dev_only

# --- Kafka ---
# Host port published by docker-compose (the broker's in-network listener is kafka:9092)
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# --- LLM (Anthropic) ---
# Keep false until you have an API key with billing enabled you're happy to use.
# The entire data platform (ingestion, ETL, gold, dashboard, alerts) runs fully
# with this set to false. Tests and `make eval` never call the real API
# regardless of this setting.
LLM_ENABLED=false
ANTHROPIC_API_KEY=
NIMBUS_AGENT_MODEL=claude-sonnet-5
NIMBUS_BRIEFING_MODEL=claude-haiku-4-5

# --- App ---
NIMBUS_ENV=dev
LOG_LEVEL=INFO
